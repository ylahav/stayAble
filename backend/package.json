{
  "name": "stayable-api",
  "version": "1.1.0",
  "private": true,
  "description": "StayAble remote API and trainer Admin (Payload CMS + MongoDB)",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --port 3000",
    "build": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap && next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start --port 3000",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@yairl/payload-db-backup-restore": "^0.1.2",
    "cross-env": "^10.1.0",
    "graphql": "^17.0.2",
    "next": "16.3.8",
    "payload": "3.90.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5"
  },
  "optionalDependencies": {
    "@img/sharp-win32-x64": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@12.9.0"
}
