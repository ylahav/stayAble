# Dedicated database — do not reuse an existing Payload CMS database.
DATABASE_URI=mongodb://127.0.0.1:27017/stayable

# Long random string (16+ characters). Required — placeholders are rejected at boot.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Created on first boot if no user with this email exists.
PAYLOAD_ADMIN_EMAIL=admin@example.com
PAYLOAD_ADMIN_PASSWORD=change-me

# Owns the seeded 20-minute program (must already exist).
PROGRAM_OWNER_EMAIL=trainer@example.com

NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Production: the HTTPS origin browsers and Flutter actually open (not localhost).
# PAYLOAD_PUBLIC_URL=https://gym.yourdomain.com

# Comma-separated extra browser origins. The public URL above is always allowed.
# Production example:
# PAYLOAD_CORS=https://gym.yourdomain.com,http://localhost:3000
PAYLOAD_CORS=http://localhost:3000

# Password assigned to new users when importing a backup pack (passwords are never exported).
# IMPORT_DEFAULT_PASSWORD=change-me-after-import
